{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Budget",
  "version": "1.0.1",
  "identifier": "ru.nemira.budget",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Бюджет",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Finance",
    "shortDescription": "Личный бюджет и учёт доходов",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi"
    ],
    "longDescription": "Личный бюджет: доходы, расходы, лимиты, цели и напоминания. Все данные хранятся только на вашем компьютере.",
    "windows": {
      "nsis": {
        "languages": [
          "Russian"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "ru-RU"
      }
    }
  }
}
